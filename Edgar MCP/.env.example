# Copy to .env and fill in. Nothing here is required to run the MCP server
# itself except EDGAR_MCP_USER_AGENT, which already has a working default.

# ---------------------------------------------------------------------------
# SEC EDGAR
# ---------------------------------------------------------------------------
# The SEC requires a User-Agent that identifies a human being. Requests without
# one get a 403. Format is "<name> <email>". Use YOUR email, not this one, if
# you are running this from your own machine at any volume.
EDGAR_MCP_USER_AGENT=Arnav arnavhpd@gmail.com

# Where cached SEC responses are written. Defaults to ./.cache
EDGAR_MCP_CACHE_DIR=.cache

# Set to 1 to bypass the on-disk cache entirely (same as passing --no-cache).
EDGAR_MCP_NO_CACHE=0

# Cache entries older than this are refetched. 0 or unset means "never expire".
# Restatements are the reason you might want a TTL here; see DEPLOYMENT.md.
EDGAR_MCP_CACHE_TTL_SECONDS=0

# ---------------------------------------------------------------------------
# Eval harness — Anthropic (default provider)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
EVAL_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Eval harness — any OpenAI-compatible endpoint (Groq, Mistral, OpenRouter,
# Together, vLLM, ...). Set EVAL_PROVIDER=openai to use these instead.
# ---------------------------------------------------------------------------
# EVAL_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# EVAL_MODEL=llama-3.3-70b-versatile
