# Local response cache for SEC HTTP responses. Never commit it: it is large,
# it goes stale when companies restate, and it can contain hundreds of MB of
# filing HTML.
.cache/

# Secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Eval output. The generated RESULTS.md and run JSON are checked in
# deliberately when a run has actually happened, so these two are negated.
evals/results/*
!evals/results/.gitkeep
!evals/results/RESULTS.md
!evals/results/run-*.json

# OS noise
.DS_Store
